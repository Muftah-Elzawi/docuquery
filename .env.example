# Copy to .env and adjust.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- Option A (default): local models via Ollama, free, nothing leaves your machine
LLM_PROVIDER=openai
LLM_API_KEY=ollama
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Option B: OpenAI (set LLM_BASE_URL here instead of the Ollama default)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Option C: no model at all (offline demo, keyword-level answers)
# LLM_PROVIDER=fake
